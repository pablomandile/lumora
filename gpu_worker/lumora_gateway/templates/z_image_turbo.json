{
    "1": {
        "class_type": "UNETLoader",
        "_meta": { "title": "Modelo de difusión" },
        "inputs": {
            "unet_name": "z_image_turbo_int8_convrot.safetensors",
            "weight_dtype": "default"
        }
    },
    "2": {
        "class_type": "CLIPLoader",
        "_meta": { "title": "Text encoder (Qwen3 4B)" },
        "inputs": {
            "clip_name": "qwen_3_4b_fp8_mixed.safetensors",
            "type": "lumina2",
            "device": "default"
        }
    },
    "3": {
        "class_type": "VAELoader",
        "_meta": { "title": "VAE" },
        "inputs": { "vae_name": "ae.safetensors" }
    },
    "4": {
        "class_type": "ModelSamplingAuraFlow",
        "_meta": { "title": "Shift" },
        "inputs": { "model": ["1", 0], "shift": 3 }
    },
    "5": {
        "class_type": "CLIPTextEncode",
        "_meta": { "title": "Prompt" },
        "inputs": { "clip": ["2", 0], "text": "" }
    },
    "6": {
        "class_type": "CLIPTextEncode",
        "_meta": { "title": "Prompt negativo (sin efecto con cfg 1)" },
        "inputs": { "clip": ["2", 0], "text": "" }
    },
    "7": {
        "class_type": "EmptySD3LatentImage",
        "_meta": { "title": "Tamaño" },
        "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
    },
    "8": {
        "class_type": "KSampler",
        "_meta": { "title": "Sampler" },
        "inputs": {
            "model": ["4", 0],
            "positive": ["5", 0],
            "negative": ["6", 0],
            "latent_image": ["7", 0],
            "seed": 0,
            "steps": 9,
            "cfg": 1,
            "sampler_name": "euler",
            "scheduler": "simple",
            "denoise": 1
        }
    },
    "9": {
        "class_type": "VAEDecode",
        "_meta": { "title": "Decodificar" },
        "inputs": { "samples": ["8", 0], "vae": ["3", 0] }
    },
    "10": {
        "class_type": "SaveImage",
        "_meta": { "title": "Guardar" },
        "inputs": { "images": ["9", 0], "filename_prefix": "lumora/imagen" }
    }
}
