{
    "1": {
        "class_type": "UnetLoaderGGUF",
        "_meta": {
            "title": "Modelo de difusión (GGUF, requiere ComfyUI-GGUF)"
        },
        "inputs": { "unet_name": "qwen-image-edit-2511-Q4_K_M.gguf" }
    },
    "2": {
        "class_type": "CLIPLoader",
        "_meta": { "title": "Text encoder (Qwen2.5-VL 7B)" },
        "inputs": {
            "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
            "type": "qwen_image",
            "device": "default"
        }
    },
    "3": {
        "class_type": "VAELoader",
        "_meta": { "title": "VAE" },
        "inputs": { "vae_name": "qwen_image_vae.safetensors" }
    },
    "4": {
        "class_type": "ModelSamplingAuraFlow",
        "_meta": { "title": "Shift" },
        "inputs": { "model": ["1", 0], "shift": 3.1 }
    },
    "5": {
        "class_type": "CFGNorm",
        "_meta": { "title": "CFGNorm" },
        "inputs": { "model": ["4", 0], "strength": 1 }
    },
    "6": {
        "class_type": "LoraLoaderModelOnly",
        "_meta": { "title": "LoRA Lightning (apareada con Edit-2511)" },
        "inputs": {
            "model": ["5", 0],
            "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors",
            "strength_model": 1.0
        }
    },
    "7": {
        "class_type": "LoadImage",
        "_meta": { "title": "Imagen 1 (la que se edita)" },
        "inputs": { "image": "" }
    },
    "8": {
        "class_type": "LoadImage",
        "_meta": { "title": "Imagen 2 (referencia)" },
        "inputs": { "image": "" }
    },
    "9": {
        "class_type": "LoadImage",
        "_meta": { "title": "Imagen 3 (referencia)" },
        "inputs": { "image": "" }
    },
    "10": {
        "class_type": "ImageScale",
        "_meta": {
            "title": "Tamaño de salida (proporción de la imagen 1, ~1 MP)"
        },
        "inputs": {
            "image": ["7", 0],
            "upscale_method": "lanczos",
            "width": 1024,
            "height": 1024,
            "crop": "disabled"
        }
    },
    "11": {
        "class_type": "TextEncodeQwenImageEditPlus",
        "_meta": { "title": "Instrucción" },
        "inputs": {
            "clip": ["2", 0],
            "prompt": "",
            "vae": ["3", 0],
            "image1": ["10", 0],
            "image2": ["8", 0],
            "image3": ["9", 0]
        }
    },
    "12": {
        "class_type": "TextEncodeQwenImageEditPlus",
        "_meta": { "title": "Negativo (sin efecto con cfg 1)" },
        "inputs": {
            "clip": ["2", 0],
            "prompt": "",
            "vae": ["3", 0],
            "image1": ["10", 0],
            "image2": ["8", 0],
            "image3": ["9", 0]
        }
    },
    "13": {
        "class_type": "FluxKontextMultiReferenceLatentMethod",
        "inputs": {
            "conditioning": ["11", 0],
            "reference_latents_method": "index_timestep_zero"
        }
    },
    "14": {
        "class_type": "FluxKontextMultiReferenceLatentMethod",
        "inputs": {
            "conditioning": ["12", 0],
            "reference_latents_method": "index_timestep_zero"
        }
    },
    "15": {
        "class_type": "VAEEncode",
        "inputs": { "pixels": ["10", 0], "vae": ["3", 0] }
    },
    "16": {
        "class_type": "KSampler",
        "_meta": { "title": "Sampler" },
        "inputs": {
            "model": ["6", 0],
            "positive": ["13", 0],
            "negative": ["14", 0],
            "latent_image": ["15", 0],
            "seed": 0,
            "steps": 4,
            "cfg": 1,
            "sampler_name": "euler",
            "scheduler": "simple",
            "denoise": 1
        }
    },
    "17": {
        "class_type": "VAEDecode",
        "_meta": { "title": "Decodificar" },
        "inputs": { "samples": ["16", 0], "vae": ["3", 0] }
    },
    "18": {
        "class_type": "SaveImage",
        "_meta": { "title": "Guardar" },
        "inputs": { "images": ["17", 0], "filename_prefix": "lumora/imagen" }
    }
}
