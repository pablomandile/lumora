# Copiá este archivo como .env (en la misma carpeta) y completalo.

# Token compartido con Lumora: el MISMO valor va en LUMORA_GPU_TOKEN del .env de Lumora.
# Generalo con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
LUMORA_GPU_TOKEN=

# Dónde escucha ComfyUI (es igual con Comfy Desktop y con la portable)
COMFY_URL=http://127.0.0.1:8188
# Carpeta output de ComfyUI: si está, se borran las imágenes cuando Lumora ya las guardó.
# Comfy Desktop:
COMFY_OUTPUT_DIR=C:\Users\TU_USUARIO\AppData\Local\Comfy-Desktop\ComfyUI-Shared\output
# Portable:
# COMFY_OUTPUT_DIR=C:\ComfyUI_windows_portable\ComfyUI\output

# Ollama de escribelo (para liberar VRAM antes de generar si hace falta)
OLLAMA_URL=http://127.0.0.1:11434
UNLOAD_OLLAMA=true
MIN_FREE_VRAM_GB=9

# Liberar la VRAM de ComfyUI después de N segundos sin generar (0 = nunca)
IDLE_FREE_SECONDS=300

# Límites
JOB_TIMEOUT_SECONDS=600
JOB_TTL_SECONDS=3600
MAX_QUEUE=20

# Archivos de Z-Image Turbo (en ComfyUI/models/diffusion_models, text_encoders y vae).
# Placa RTX 30/40/50 con 12 GB: los int8/fp8 de abajo.
# Si la placa no soporta int8 (error al generar), usá z_image_turbo_bf16.safetensors.
ZIMAGE_UNET=z_image_turbo_int8_convrot.safetensors
ZIMAGE_CLIP=qwen_3_4b_fp8_mixed.safetensors
ZIMAGE_VAE=ae.safetensors
